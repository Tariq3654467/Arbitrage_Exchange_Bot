# ===========================================
# ARBITRAGE BOT - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ----- DATABASE CONFIGURATION -----
POSTGRES_DB=arbitrage_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- INFLUXDB CONFIGURATION -----
INFLUXDB_PASSWORD=your_influx_password
INFLUXDB_ORG=arbitrage_org
INFLUXDB_BUCKET=price_data
INFLUXDB_TOKEN=your_influx_token
INFLUXDB_URL=http://influxdb:8086

# ----- REDIS CONFIGURATION -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- GRAFANA CONFIGURATION -----
GRAFANA_PASSWORD=admin

# ----- APPLICATION SETTINGS -----
ENVIRONMENT=production
LOG_LEVEL=INFO

# ----- API AUTHENTICATION (for dashboard) -----
API_USERNAME=admin
API_PASSWORD=admin

# ----- BINANCE API KEYS -----
BINANCE_API_KEY=your_key
BINANCE_API_SECRET=your_secret
BINANCE_TESTNET=false

# ----- MEXC API KEYS -----
MEXC_API_KEY=your_key
MEXC_API_SECRET=your_secret
MEXC_TESTNET=false

# ----- GALA CHAIN WALLET -----
GALA_WALLET_ADDRESS=your_address
GALA_PRIVATE_KEY=your_key
GALA_PUBLIC_KEY=your_key
GALA_RPC_URL=https://jsonrpc.gala.games

# ----- OPTIONAL: OTHER EXCHANGES -----
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# OKX_TESTNET=false

# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# BYBIT_TESTNET=false

# ----- OPTIONAL: MONITORING -----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SENDGRID_API_KEY=
# ALERT_EMAIL=

# ----- OPTIONAL: SECURITY -----
# ENCRYPTION_KEY=
# ALLOWED_IPS=

# ----- OPTIONAL: TRADING PARAMETERS (override config.yaml) -----
# MIN_PROFIT_THRESHOLD=
# MAX_TRADE_SIZE_PERCENT=
# MAX_SLIPPAGE_PERCENT=
# MAX_DRAWDOWN_PERCENT=
